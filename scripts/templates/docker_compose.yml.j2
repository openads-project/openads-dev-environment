services:

  {{ service_name }}:
    image: {{ image }}
    environment:
      # --- name ------
      NAMESPACE: {{ namespace }}
      NAME: {{ node_name }}
{% if input_variables %}
      # --- inputs ----
{% for variable in input_variables %}
      {{ variable.name }}: {{ variable.value }}
{% endfor %}
{% endif %}
{% if output_variables %}
      # --- outputs ---
{% for variable in output_variables %}
      {{ variable.name }}: {{ variable.value }}
{% endfor %}
{% endif %}
      # --- other -----
{% for variable in other_topic_variables %}
      {{ variable.name }}: {{ variable.value }}
{% endfor %}
{% for variable in other_environment_variables %}
{% if variable.host_exposed %}
      {{ variable.name }}: ${{ "{" }}{{ variable.name }}:-{{ variable.value }}{{ "}" }}
{% elif variable.value == "" %}
      {{ variable.name }}: ""
{% else %}
      {{ variable.name }}: {{ variable.value }}
{% endif %}
{% endfor %}
    command:
      - /bin/bash
      - -ic
      - |
        ros2 launch {{ launch_package }} {{ launch_file_name }} \
{% for argument in launch_arguments %}
{% if argument.only_if_set %}
          $${{ "{" }}{{ argument.env_name }}:+{{ argument.name }}:=$${{ "{" }}{{ argument.env_name }}{{ "}" }}{{ "}" }}{{ " \\" if not loop.last else "" }}
{% else %}
          {{ argument.name }}:=$${{ "{" }}{{ argument.env_name }}{{ "}" }}{{ " \\" if not loop.last else "" }}
{% endif %}
{% endfor %}
{% if params_default_path %}
    # volumes:
    #   - ./params.yml:{{ params_default_path }}
{% endif %}
